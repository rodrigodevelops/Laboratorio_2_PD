# Copiar a .env antes de levantar el producto:  cp .env.example .env
# Cambie las claves si el producto se expone fuera de su computadora.

# Base de datos del producto (también aloja la base de MLflow)
POSTGRES_PASSWORD=cambiar-clave-producto

# Base de datos de Airflow (contenedor separado)
AIRFLOW_DB_PASSWORD=cambiar-clave-airflow

# Usuario administrador de Airflow (interfaz y API usada para reentrenar)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar-clave-admin

# Secreto para los tokens internos de Airflow
AIRFLOW_JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio
